# PostgreSQL Database Connection String
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mini_erp_db?schema=public

# Server Listening Port (Default: 5000 in dev; overridden in production)
PORT=5000

# JSON Web Token Secret (Use strong secret in production)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-long

# JWT Expiration Duration
JWT_EXPIRES_IN=24h

# Frontend Application Origin for CORS
FRONTEND_URL=http://localhost:5173

# Allowed CORS Origins (Comma-separated list for multi-origin setups)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
