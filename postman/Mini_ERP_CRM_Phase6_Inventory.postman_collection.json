{
  "info": {
    "_postman_id": "c6b03e15-2345-6789-90ab-cdef01234567",
    "name": "Mini ERP + CRM - Phase 6 Inventory & Stock Movements",
    "description": "Postman Collection for testing Phase 6 Inventory Management REST APIs, transactional stock IN/OUT movements, negative stock protection, and RBAC rules.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Inventory Movements",
      "item": [
        {
          "name": "Create Stock IN Movement (Admin / Warehouse)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"REPLACE_WITH_PRODUCT_ID\",\n  \"quantity\": 50,\n  \"movementType\": \"IN\",\n  \"reason\": \"New stock shipment received from vendor\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/inventory/movements",
              "host": ["{{baseUrl}}"],
              "path": ["inventory", "movements"]
            }
          }
        },
        {
          "name": "Create Stock OUT Movement (Admin / Warehouse)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"REPLACE_WITH_PRODUCT_ID\",\n  \"quantity\": 10,\n  \"movementType\": \"OUT\",\n  \"reason\": \"Internal store requisition for display\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/inventory/movements",
              "host": ["{{baseUrl}}"],
              "path": ["inventory", "movements"]
            }
          }
        },
        {
          "name": "Get Stock Movements Audit Log",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/inventory/movements?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["inventory", "movements"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Filter IN Movements Only",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/inventory/movements?movementType=IN",
              "host": ["{{baseUrl}}"],
              "path": ["inventory", "movements"],
              "query": [
                { "key": "movementType", "value": "IN" }
              ]
            }
          }
        },
        {
          "name": "Filter OUT Movements Only",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/inventory/movements?movementType=OUT",
              "host": ["{{baseUrl}}"],
              "path": ["inventory", "movements"],
              "query": [
                { "key": "movementType", "value": "OUT" }
              ]
            }
          }
        },
        {
          "name": "Get Stock Movement By ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/inventory/movements/:id",
              "host": ["{{baseUrl}}"],
              "path": ["inventory", "movements", ":id"],
              "variable": [
                { "key": "id", "value": "REPLACE_WITH_MOVEMENT_ID" }
              ]
            }
          }
        }
      ]
    }
  ]
}
