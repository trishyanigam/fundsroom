{
  "info": {
    "_postman_id": "d7c14f26-3456-7890-a1bc-def012345678",
    "name": "Mini ERP + CRM - Phase 7 Sales Challans Management",
    "description": "Postman Collection for testing Phase 7 Sales Challan REST APIs, draft creation, product historical snapshots, auto-generated challan numbers, editing drafts, and draft cancellation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Challans",
      "item": [
        {
          "name": "Create Draft Challan (Admin / Sales)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"REPLACE_WITH_CUSTOMER_ID\",\n  \"items\": [\n    {\n      \"productId\": \"REPLACE_WITH_PRODUCT_ID_1\",\n      \"quantity\": 2\n    },\n    {\n      \"productId\": \"REPLACE_WITH_PRODUCT_ID_2\",\n      \"quantity\": 5\n    }\n  ],\n  \"status\": \"DRAFT\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/challans",
              "host": ["{{baseUrl}}"],
              "path": ["challans"]
            }
          }
        },
        {
          "name": "Get Sales Challans List (Paginated)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/challans?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["challans"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Search Challans by Number or Customer",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/challans?search=CH-2026",
              "host": ["{{baseUrl}}"],
              "path": ["challans"],
              "query": [
                { "key": "search", "value": "CH-2026" }
              ]
            }
          }
        },
        {
          "name": "Filter Draft Challans Only",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/challans?status=DRAFT",
              "host": ["{{baseUrl}}"],
              "path": ["challans"],
              "query": [
                { "key": "status", "value": "DRAFT" }
              ]
            }
          }
        },
        {
          "name": "Get Challan Details By ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/challans/:id",
              "host": ["{{baseUrl}}"],
              "path": ["challans", ":id"],
              "variable": [
                { "key": "id", "value": "REPLACE_WITH_CHALLAN_ID" }
              ]
            }
          }
        },
        {
          "name": "Update Draft Challan (Admin / Sales)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"REPLACE_WITH_CUSTOMER_ID\",\n  \"items\": [\n    {\n      \"productId\": \"REPLACE_WITH_PRODUCT_ID_1\",\n      \"quantity\": 3\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/challans/:id",
              "host": ["{{baseUrl}}"],
              "path": ["challans", ":id"],
              "variable": [
                { "key": "id", "value": "REPLACE_WITH_CHALLAN_ID" }
              ]
            }
          }
        },
        {
          "name": "Cancel Draft Challan (Admin / Sales)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/challans/:id/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["challans", ":id", "cancel"],
              "variable": [
                { "key": "id", "value": "REPLACE_WITH_CHALLAN_ID" }
              ]
            }
          }
        }
      ]
    }
  ]
}
